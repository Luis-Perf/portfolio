---
import { site } from '../config/site';
import Base from '../layouts/Base.astro';
import { useTranslations } from '../i18n/ui';

const t = useTranslations('pt');
const en = useTranslations('en');
---

<Base lang="pt" title={`${t.notFound.title} — ${site.name}`} description={t.notFound.text} alternates={{ pt: '/', en: '/en/' }} noindex>
  <section class="container not-found">
    <p class="label">404</p>
    <h1>{t.notFound.title}</h1>
    <p>{t.notFound.text}</p>
    <p lang="en" class="en">{en.notFound.text}</p>
    <div class="actions">
      <a class="button button--primary" href="/">{t.notFound.back}</a>
      <a class="button button--ghost" href="/en/" lang="en">{en.notFound.back}</a>
    </div>
  </section>
</Base>

<style>
  .not-found {
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding-block: 6rem;
  }

  h1 {
    font-size: clamp(2.4rem, 1.6rem + 3.6vw, 4rem);
    font-weight: 800;
  }

  .en {
    color: var(--ink-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1rem;
  }
</style>
