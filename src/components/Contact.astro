---
import { site } from '../config/site';
import { useTranslations, type Lang } from '../i18n/ui';
import Icon from './Icon.astro';
import Section from './Section.astro';
import WhatsAppLink from './WhatsAppLink.astro';

interface Props {
  lang: Lang;
  index: number;
}

const { lang, index } = Astro.props;
const t = useTranslations(lang);
---

<Section id={t.sections.contact.id} index={index} title={t.sections.contact.title} end>
  <div class="panel reveal">
    <div>
      <p class="pitch">{t.contact.title}</p>
      <p class="text">{t.contact.text}</p>
    </div>
    <div class="actions">
      <WhatsAppLink lang={lang} label={t.contact.whatsapp} class="button--primary" />
      <a class="button button--ghost" href={site.vcard} download>
        <Icon name="contact" />
        {t.contact.saveContact}
      </a>
    </div>
    <ul class="links" role="list">
      <li>
        <a href={site.github} target="_blank" rel="noopener noreferrer">
          <Icon name="github" />
          {t.contact.github}
          <span class="sr-only">{t.a11y.opensInNewTab}</span>
        </a>
      </li>
      {
        site.linkedin && (
          <li>
            <a href={site.linkedin} target="_blank" rel="noopener noreferrer">
              <Icon name="linkedin" />
              {t.contact.linkedin}
              <span class="sr-only">{t.a11y.opensInNewTab}</span>
            </a>
          </li>
        )
      }
      {
        site.email && (
          <li>
            <a href={`mailto:${site.email}`}>
              <Icon name="mail" />
              {site.email}
            </a>
          </li>
        )
      }
      <li class="phone">{site.phoneDisplay}</li>
    </ul>
  </div>
</Section>

<style>
  .panel {
    --panel-ink: var(--paper);
    display: grid;
    gap: 2rem;
    padding: 2rem 1.5rem;
    color: var(--panel-ink);
    background: var(--ink);
    border-radius: var(--radius);
  }

  .pitch {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 1.3rem + 2vw, 2.6rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .text {
    margin-top: 0.9rem;
    max-width: 36rem;
    opacity: 0.85;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .panel :global(.button--primary) {
    box-shadow: 3px 3px 0 var(--panel-ink);
  }

  .panel .button--ghost {
    color: var(--panel-ink);
    border-color: var(--panel-ink);
  }

  .panel .button--ghost:hover {
    background: color-mix(in srgb, var(--panel-ink) 12%, transparent);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px dashed color-mix(in srgb, var(--panel-ink) 35%, transparent);
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .links :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .phone {
    opacity: 0.8;
  }

  .panel :focus-visible {
    outline-color: var(--accent);
  }

  @media (min-width: 52rem) {
    .panel {
      grid-template-columns: minmax(0, 1.3fr) auto;
      align-items: end;
      padding: 3rem;
    }

    .links {
      grid-column: 1 / -1;
    }
  }
</style>
