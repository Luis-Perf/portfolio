---
import { site } from '../config/site';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="container">
  <dl class="title-block">
    <div class="cell main">
      <dt class="sr-only">{site.name}</dt>
      <dd class="name">{site.name}</dd>
      <dd class="role">{t.footer.role}</dd>
    </div>
    {
      site.email && (
        <div class="cell email">
          <dt class="label">{t.contact.email}</dt>
          <dd>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </dd>
        </div>
      )
    }
    <div class="cell">
      <dt class="label">{t.footer.elsewhere}</dt>
      <dd class="links">
        {
          site.linkedin && (
            <a href={site.linkedin} target="_blank" rel="noopener noreferrer">
              {t.contact.linkedin}
              <span class="sr-only">{t.a11y.opensInNewTab}</span>
            </a>
          )
        }
        <a href={site.github} target="_blank" rel="noopener noreferrer">
          {t.contact.github}
          <span class="sr-only">{t.a11y.opensInNewTab}</span>
        </a>
      </dd>
    </div>
    <div class="cell">
      <dt class="label">©</dt>
      <dd>{year}</dd>
    </div>
  </dl>
</footer>

<style>
  footer {
    padding-bottom: 2rem;
  }

  .title-block {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1.5px solid var(--ink);
    background: var(--surface);
  }

  .cell {
    padding: 0.75rem 1rem;
    border-right: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
  }

  .main,
  .email {
    grid-column: 1 / -1;
  }

  dd {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    overflow-wrap: break-word;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .role {
    color: var(--ink-soft);
  }

  @media (min-width: 48rem) {
    .title-block {
      grid-template-columns: 2fr 1.5fr 1fr 0.6fr;
    }

    .main,
    .email {
      grid-column: auto;
    }

    .cell {
      border-bottom: 0;
    }

    .cell:last-child {
      border-right: 0;
    }
  }
</style>
