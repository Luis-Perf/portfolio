---
interface Props {
  metrics: { value: string; label: string }[];
  heading: string;
  size?: 'md' | 'lg';
}

const { metrics, heading, size = 'md' } = Astro.props;
---

<div class:list={['metrics', size]}>
  <p class="sr-only">{heading}</p>
  <dl>
    {
      metrics.map((metric) => (
        <div class="metric">
          <dt class="value">{metric.value}</dt>
          <dd>{metric.label}</dd>
        </div>
      ))
    }
  </dl>
</div>

<style>
  dl {
    display: grid;
    gap: 1.5rem;
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-left: 1rem;
    border-left: 3px solid var(--accent);
  }

  .value {
    order: -1;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.6rem + 1.4vw, 2.6rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-wrap: balance;
  }

  .lg .value {
    font-size: clamp(2.4rem, 1.8rem + 2vw, 3.4rem);
  }

  dd {
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--ink-soft);
  }
</style>
