---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = useTranslations(lang).hero.diagram;

const connectors = [
  { key: 'store', path: 'M95 96 V199 Q95 205 101 205 H175', labelX: 105, labelY: 150, anchor: 'start', reverse: false },
  { key: 'erp', path: 'M425 96 V199 Q425 205 419 205 H345', labelX: 415, labelY: 150, anchor: 'end', reverse: true },
  { key: 'bank', path: 'M95 344 V241 Q95 235 101 235 H175', labelX: 105, labelY: 298, anchor: 'start', reverse: true },
  { key: 'suppliers', path: 'M425 344 V241 Q425 235 419 235 H345', labelX: 415, labelY: 298, anchor: 'end', reverse: false },
] as const;

const nodes = [
  { key: 'store', x: 20, y: 40 },
  { key: 'erp', x: 350, y: 40 },
  { key: 'bank', x: 20, y: 344 },
  { key: 'suppliers', x: 350, y: 344 },
] as const;

const cropMarks = [
  [4, 4, 1, 1],
  [516, 4, -1, 1],
  [4, 436, 1, -1],
  [516, 436, -1, -1],
] as const;
---

<figure class="diagram">
  <svg viewBox="0 0 520 440" role="img" aria-labelledby="diagram-title diagram-desc">
    <title id="diagram-title">{d.title}</title>
    <desc id="diagram-desc">{d.description}</desc>

    {cropMarks.map(([x, y, dx, dy]) => <path class="crop" d={`M${x} ${y + 14 * dy} V${y} H${x + 14 * dx}`} />)}

    <g class="dimension">
      <path d="M20 22 H500 M20 16 V28 M500 16 V28" />
    </g>

    {
      connectors.map((c) => (
        <g>
          <path class="wire" d={c.path} />
          <path class:list={['flow', { reverse: c.reverse }]} d={c.path} />
          <text class="flow-label" x={c.labelX} y={c.labelY} text-anchor={c.anchor}>
            {d.flows[c.key]}
          </text>
        </g>
      ))
    }

    {
      nodes.map((n) => (
        <g>
          <rect class="node" x={n.x} y={n.y} width="150" height="56" rx="3" />
          <circle class="port" cx={n.x + 75} cy={n.y < 200 ? n.y + 56 : n.y} r="3.5" />
          <text class="node-label" x={n.x + 75} y={n.y + 33} text-anchor="middle">
            {d.nodes[n.key]}
          </text>
        </g>
      ))
    }

    <g>
      <rect class="hub" x="175" y="175" width="170" height="90" rx="3" />
      <text class="hub-label" x="260" y="219" text-anchor="middle">{d.hub}</text>
      <text class="hub-caption" x="260" y="241" text-anchor="middle">{d.hubCaption}</text>
    </g>
  </svg>
  <figcaption class="label">{d.figure}</figcaption>
</figure>

<style>
  .diagram {
    display: grid;
    gap: 0.75rem;
  }

  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .crop,
  .dimension path {
    fill: none;
    stroke: var(--rule-strong);
    stroke-width: 1;
  }

  .wire {
    fill: none;
    stroke: var(--rule-strong);
    stroke-width: 1.5;
  }

  .flow {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 2 14;
  }

  @media (prefers-reduced-motion: no-preference) {
    .flow {
      animation: flow 1.6s linear infinite;
    }

    .flow.reverse {
      animation-direction: reverse;
    }
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -32;
    }
  }

  .node {
    fill: var(--surface);
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .port {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .node-label {
    fill: var(--ink);
    font: 600 18px var(--font-body);
  }

  .flow-label {
    fill: var(--ink-soft);
    font: 500 13px var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hub {
    fill: var(--ink);
    stroke: var(--accent);
    stroke-width: 2.5;
  }

  .hub-label {
    fill: var(--paper);
    font: 700 21px var(--font-display);
  }

  .hub-caption {
    fill: var(--accent);
    font: 500 11.5px var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  figcaption {
    text-align: right;
  }
</style>
